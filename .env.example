NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# CLI/agent: apply supabase/migrations (Dashboard → Account → Access Tokens)
# SUPABASE_ACCESS_TOKEN=sbp_...

# Require Google sign-in for all pages and APIs (except /welcome, /auth/callback, /privacy)
AUTH_REQUIRED=true
NEXT_PUBLIC_AUTH_REQUIRED=true

# OAuth redirect (local + production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Capacitor native shell — WebView loads Next dev/prod server (optional)
# Emulator Android: http://10.0.2.2:3000
# Physical device: http://<your-lan-ip>:3000
# CAPACITOR_SERVER_URL=http://10.0.2.2:3000

# Setup (optional — app works without Supabase via sessionStorage):
# 1. Copy to .env.local
# 2. Run all files in supabase/migrations/ (001 → 006) in SQL Editor
# 3. Optional: enable Realtime on public.links
# 4. Google login: docs/GOOGLE_AUTH.md

# Founder/dev: always purple Rimvio avatar on this machine
# NEXT_PUBLIC_FOUNDER_PURPLE=1

# Naver Search API (local · shop · news · blog · web · image …)
# https://developers.naver.com/apps/#/register
# Application → API 설정 → 검색 API 사용
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# Google Cloud Vision OCR + WEB_DETECTION (optional — screenshot accuracy boost)
# Use a Vision API key only — do NOT reuse for Places or Gemini.
# https://cloud.google.com/vision/docs/ocr
# GOOGLE_CLOUD_VISION_API_KEY=

# Gemini — photo place/product recognition (/api/locate, /api/capture/vision)
# https://ai.google.dev/
# GEMINI_API_KEY=
# GOOGLE_GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-1.5-flash

# Vision provider switch — use OpenAI when Gemini billing is unavailable
# CAPTURE_VISION_PROVIDER=openai   # openai | gemini (default: gemini, or openai if only OpenAI key set)

# OpenAI — OCR refine + optional vision capture (gpt-4o-mini)
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_OCR_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini

# Google Places — Find Place for lat/lng (/api/locate)
# Use a Places-enabled key — do NOT fall back to Vision key.
# https://developers.google.com/maps/documentation/places/web-service/search-find-place
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Google Custom Search — similar clothing image results (optional)
# https://developers.google.com/custom-search/v1/overview
# GOOGLE_CSE_ID=
# GOOGLE_CSE_API_KEY=

# Web Push (optional — background notifications when app is closed)
# Generate VAPID keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# OpenWeatherMap — JIT weather context (optional)
# https://openweathermap.org/api
# OPENWEATHER_API_KEY=

# https://developers.kakao.com/
# NEXT_PUBLIC_KAKAO_JS_KEY=
# REST API key — Local search + Mobility Directions (/api/context/traffic)
# KAKAO_REST_API_KEY=

# User integrations — OAuth (Slack, Notion) + encrypted token storage
# Generate: openssl rand -base64 32
# INTEGRATIONS_ENCRYPTION_KEY=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# OAuth redirect: {NEXT_PUBLIC_APP_URL}/api/integrations/oauth/callback

# LLM creative action candidates (travel/work) — POST /api/actions/llm-candidates
# Set to 0/false to disable client-side LLM enrichment in prep surface
# RIMVIO_LLM_ACTION_CANDIDATES=1
# OPENAI_API_KEY=   (required for use_llm:true)
