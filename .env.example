# Rimvio — copy to .env.local for local dev
# Vercel: set Production + Preview (Dashboard or scripts/vercel-env-setup.ps1)

# ── Core (production recommended) ─────────────────────────────
# Local Supabase dev: after `supabase start`, paste the printed URL + anon key here.
# If you only want deploy verification against hosted env, use `.env.vercel.production`
# and run `npm run verify:deploy -- --vercel-env` or `npm run verify:deploy -- --remote`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only — bridge contribution upsert (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Production site origin — required for Google OAuth + deploy verification
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth lockdown (optional) ───────────────────────────────────
# AUTH_REQUIRED=true
# NEXT_PUBLIC_AUTH_REQUIRED=true

# ── Supabase CLI migrations only (not runtime) ─────────────────
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=your_project_ref

# ── Vision / locate (optional) ────────────────────────────────
# GEMINI_API_KEY=
# GOOGLE_GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.5-flash
# GEMINI_TEXT_MAX_OUTPUT_TOKENS=2048
# GEMINI_JSON_MAX_OUTPUT_TOKENS=4096
# GEMINI_VISION_MAX_OUTPUT_TOKENS=4096
# GEMINI_CHAT_THINKING_BUDGET=0
# GOOGLE_CLOUD_VISION_API_KEY=
# YOUTUBE_DATA_API_KEY=
# Optional override for official YouTube metadata/search.
# If unset, Rimvio falls back to GOOGLE_PLACES_API_KEY, then GOOGLE_MAPS_API_KEY,
# when that same Google key also has YouTube Data API v3 enabled.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=
# CAPTURE_VISION_PROVIDER=gemini
# COMPOSE_LLM_PROVIDER=gemini

# ── LLM (optional) ───────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_OCR_MODEL=
# OPENAI_VISION_MODEL=

# ── Search / commerce (optional) ─────────────────────────────
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=
# OPENWEATHER_API_KEY=

# ── Integrations (required in prod if using Slack/Notion OAuth) ─
# INTEGRATIONS_ENCRYPTION_KEY=
# Per-user personal vault envelope encryption (prod required)
# VAULT_ENCRYPTION_KEY=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# Google Calendar sync (readonly) — redirect: {NEXT_PUBLIC_APP_URL}/api/integrations/oauth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Hub checkout / PG (optional) ─────────────────────────────
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# KAKAO_PAY_CID=
# KAKAO_PAY_SECRET=

# ── LiteAPI / Nuitee Connect (hotel inventory + checkout) ─────
# Dashboard: https://connect.nuitee.com/
# Docs: https://docs.liteapi.travel/reference/authentication
# LITEAPI_API_KEY=sandbox_...   # or prod_...
# LITEAPI_DISPLAY_CURRENCY=KRW
# LITEAPI_GUEST_NATIONALITY=KR
# LITEAPI_SEARCH_RADIUS_M=5000
# LITEAPI_MARGIN_PERCENT=10

# ── Airbnb partner (optional — apply at https://developer.withairbnb.com/) ─
# Default without credentials: handoff deep-link to airbnb.com when scout lodgingKind=airbnb.
# AIRBNB_INTEGRATION_MODE=handoff
# AIRBNB_INTEGRATION_MODE=disabled
# AIRBNB_PARTNER_CLIENT_ID=
# AIRBNB_PARTNER_CLIENT_SECRET=
# AIRBNB_PARTNER_API_BASE_URL=https://api.airbnb.com

# ── Kakao (optional) ─────────────────────────────────────────
# KAKAO_REST_API_KEY=
# NEXT_PUBLIC_KAKAO_JS_KEY=

# ── PWA / dev flags (optional) ───────────────────────────────
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_ROOM_MVP=0
# NEXT_PUBLIC_DEV_SURFACES=0
# CAPACITOR_SERVER_URL=https://your-app.vercel.app
