# Default in code is https://rimvio.com. Use localhost only when pairing against local Next.
RIMVIO_API_BASE_URL=https://rimvio.com
RIMVIO_DEVICE_ID=
RIMVIO_DEVICE_TOKEN=
RIMVIO_DEVICE_NAME=My PC
RIMVIO_EXECUTION_ENGINE=browser
# Reuse the Chrome you already logged into (keep Chrome running):
#   chrome.exe --remote-debugging-port=9222
# RIMVIO_CHROME_CDP_URL=http://127.0.0.1:9222
# Optional Chromium profile if CDP is not used
# RIMVIO_BROWSER_PROFILE=
