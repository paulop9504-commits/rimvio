{
  "name": "rimvio-pc",
  "productName": "Rimvio PC",
  "version": "0.1.0",
  "private": true,
  "description": "Rimvio PC — connect this computer to Rimvio",
  "author": "Rimvio",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "bundle-agent": "npx esbuild ../local-agent/src/desktop-main.ts --bundle --platform=node --format=cjs --outfile=resources/agent.cjs --external:playwright",
    "dist": "npm run bundle-agent && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.rimvio.pc",
    "productName": "Rimvio PC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.cjs"
    ],
    "extraResources": [
      {
        "from": "resources/agent.cjs",
        "to": "agent.cjs"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Rimvio-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rimvio PC"
    }
  }
}
